---
import { Image } from 'astro:assets';
import { carousel } from '../data/carousel.js';

const paintings = import.meta.glob('../gallery/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const references = import.meta.glob(
  '../gallery/references/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const pick = (modules, file) => {
  const entry = Object.entries(modules).find(
    ([p]) => p.split('/').pop() === file
  );
  return entry ? entry[1].default : null;
};

// Newest first, driven by the painting's number prefix rather than by where
// the entry sits in carousel.js — so a new pair added anywhere in that file
// still leads the carousel. Matches how the Gallery page orders itself.
const rank = (file) => {
  const m = file.match(/^(\d+)-/);
  return m ? Number(m[1]) : -1;
};

const slides = carousel
  .map((item) => ({
    title: item.title,
    file: item.painting,
    painting: pick(paintings, item.painting),
    references: (item.references ?? [])
      .map((f) => pick(references, f))
      .filter(Boolean),
  }))
  .filter((s) => s.painting)
  .sort((a, b) => rank(b.file) - rank(a.file));

// Rotation interval in milliseconds.
const INTERVAL = 8000;
---

<div class="carousel" data-carousel data-interval={INTERVAL}>
  <div class="carousel-stage">
    {
      slides.map((slide, i) => (
        <div
          class:list={['cslide', { active: i === 0 }]}
          hidden={i !== 0}
        >
          {slide.references.length > 0 && (
            <figure class="frame ref-frame">
              <div
                class:list={[
                  'ref-stack',
                  { multi: slide.references.length > 1 },
                ]}
              >
                {slide.references.map((ref) => (
                  <Image
                    src={ref}
                    alt={`Reference photo of ${slide.title ?? 'the pet'}`}
                    widths={[300, 600]}
                    sizes="(max-width: 700px) 45vw, 300px"
                  />
                ))}
              </div>
            </figure>
          )}

          <span class="arrow" aria-hidden="true">→</span>

          <figure class="frame paint-frame">
            <Image
              src={slide.painting}
              alt={
                slide.title
                  ? `Painting of ${slide.title}`
                  : 'Custom pet portrait by ACC Paintings'
              }
              widths={[400, 800]}
              sizes="(max-width: 700px) 82vw, 460px"
            />
          </figure>
        </div>
      ))
    }

    {
      slides.length > 1 && (
        <Fragment>
          <button
            class="cnav cnav-prev"
            data-cprev
            type="button"
            aria-label="Previous pair"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15 5.5 L9 12 L15 18.5" />
            </svg>
          </button>
          <button
            class="cnav cnav-next"
            data-cnext
            type="button"
            aria-label="Next pair"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9 5.5 L15 12 L9 18.5" />
            </svg>
          </button>
        </Fragment>
      )
    }
  </div>

  {
    slides.length > 1 && (
      <div class="carousel-dots" role="tablist" aria-label="Choose a pair">
        {slides.map((slide, i) => (
          <button
            class="cdot"
            aria-label={`Show ${slide.title ?? `pair ${i + 1}`}`}
            aria-current={i === 0 ? 'true' : 'false'}
          />
        ))}
      </div>
    )
  }
</div>

<style>
  .carousel {
    --stage-h: clamp(360px, 48vw, 504px);
  }

  .carousel-stage {
    position: relative;
    min-height: var(--stage-h);
  }

  .cslide {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: var(--stage-h);
  }

  .cslide.active {
    animation: cfade 0.6s ease;
  }

  .cslide[hidden] {
    display: none;
  }

  @keyframes cfade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .frame {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .frame :global(img) {
    border-radius: 12px;
    box-shadow: var(--shadow);
    display: block;
    height: auto;
  }

  /* Reference column */
  .ref-frame :global(img) {
    max-height: calc(var(--stage-h) - 70px);
    width: auto;
    max-width: 240px;
  }

  .ref-stack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .ref-stack.multi :global(img) {
    max-height: calc((var(--stage-h) - 90px) / 2);
    max-width: 180px;
  }

  /* Painting */
  .paint-frame :global(img) {
    max-height: calc(var(--stage-h) - 60px);
    width: auto;
    max-width: min(504px, 72vw);
  }

  .arrow {
    font-size: 1.8rem;
    color: var(--accent);
    flex: none;
  }

  /* Sits over the stage, which is position: relative. Distinct from .arrow,
     the "photo → painting" glyph between the two frames. */
  .cnav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--white);
    color: var(--ink-soft);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: color 0.15s ease, border-color 0.15s ease,
      background 0.15s ease;
  }

  /* The chevron is geometrically centred in its 24×24 viewBox (x and y both
     span 9→15 / 5.5→18.5 around 12), so flex centring lands it exactly. */
  .cnav svg {
    display: block;
    width: 42%;
    height: 42%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cnav:hover {
    color: var(--accent-deep);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .cnav-prev {
    left: 0;
  }

  .cnav-next {
    right: 0;
  }

  @media (max-width: 700px) {
    .cnav {
      width: 36px;
      height: 36px;
    }
  }

  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.6rem;
  }

  .cdot {
    width: 10px;
    height: 10px;
    padding: 0;
    border-radius: 50%;
    border: none;
    background: var(--line);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .cdot:hover {
    background: var(--ink-soft);
  }

  .cdot[aria-current='true'] {
    background: var(--accent);
    transform: scale(1.25);
  }

  @media (max-width: 640px) {
    .carousel {
      --stage-h: auto;
    }
    .cslide {
      flex-direction: column;
      gap: 1rem;
      padding-block: 1rem;
    }
    .arrow {
      transform: rotate(90deg);
    }
    .ref-stack.multi {
      flex-direction: row;
    }
    .ref-frame :global(img),
    .ref-stack.multi :global(img) {
      max-height: 200px;
      max-width: 45vw;
    }
    .paint-frame :global(img) {
      max-height: none;
      max-width: 82vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cslide.active {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll('.cslide'));
    const dots = Array.from(root.querySelectorAll('.cdot'));
    if (slides.length < 2) return;

    const interval = Number(root.dataset.interval) || 10000;
    let current = 0;
    let timer = null;

    const show = (n) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        const on = k === current;
        s.hidden = !on;
        s.classList.toggle('active', on);
      });
      dots.forEach((d, k) =>
        d.setAttribute('aria-current', k === current ? 'true' : 'false')
      );
    };

    const start = () => {
      stop();
      timer = window.setInterval(() => show(current + 1), interval);
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = null;
    };

    dots.forEach((d, k) =>
      d.addEventListener('click', () => {
        show(k);
        start();
      })
    );

    // Arrows step through the same wrapping sequence as auto-rotation, and
    // restart the timer so it doesn't advance again a moment after a click.
    root.querySelector('[data-cprev]')?.addEventListener('click', () => {
      show(current - 1);
      start();
    });
    root.querySelector('[data-cnext]')?.addEventListener('click', () => {
      show(current + 1);
      start();
    });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);

    show(0);
    start();
  });
</script>
