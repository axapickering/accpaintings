---
const { pathname } = Astro.url;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/info', label: 'Info & FAQ' },
  { href: '/commission', label: 'Commission' },
];
const isActive = (href) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="ACC Paintings home">
      <span class="brand-mark">ACC</span>
      <span class="brand-word">Paintings</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--cream) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--ink);
  }

  .brand-mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    color: var(--accent-deep);
  }

  .brand-word {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-style: italic;
  }

  .site-nav {
    display: flex;
    gap: 0.4rem;
  }

  .nav-link {
    color: var(--ink-soft);
    font-weight: 500;
    font-size: 0.98rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--ink);
    background: var(--cream-deep);
  }

  .nav-link.active {
    color: var(--accent-deep);
    background: var(--accent-soft);
  }

  .nav-toggle,
  .nav-burger {
    display: none;
  }

  .nav-burger {
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 8px;
  }

  .nav-burger span {
    width: 24px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 720px) {
    .nav-burger {
      display: flex;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--cream);
      border-bottom: 1px solid var(--line);
      padding: 0.5rem clamp(1.2rem, 4vw, 2.5rem) 1rem;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .nav-toggle:checked ~ .site-nav {
      max-height: 320px;
    }

    .nav-link {
      padding: 0.8rem 0.6rem;
      border-radius: 8px;
    }

    .nav-toggle:checked ~ .nav-burger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
