---
import { Image } from 'astro:assets';
import { captions } from '../data/gallery-captions.js';

// Auto-discover every image in src/gallery/. Drop a file in that folder and
// it shows up here — no code changes needed.
const modules = import.meta.glob('../gallery/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});

const { limit } = Astro.props;

// Files named "sample-*" are placeholders used only by the home-page carousel,
// so they're kept out of the gallery grid.
let images = Object.entries(modules)
  .map(([path, mod]) => {
    const file = path.split('/').pop();
    return {
      file,
      src: mod.default,
      caption: captions[file] ?? null,
    };
  })
  .filter((img) => !img.file.startsWith('sample-'))
  .sort((a, b) => a.file.localeCompare(b.file));

if (limit) images = images.slice(0, limit);
---

<div class="gallery" data-gallery>
  {
    images.map((img, i) => (
      <figure class="gallery-item">
        <button
          class="gallery-trigger"
          data-full={img.src.src}
          data-title={img.caption?.title ?? ''}
          data-note={img.caption?.note ?? ''}
          aria-label={img.caption?.title
            ? `View ${img.caption.title} larger`
            : 'View painting larger'}
        >
          <Image
            src={img.src}
            alt={img.caption?.title ?? 'Custom pet portrait by ACC Paintings'}
            widths={[400, 800]}
            sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 33vw"
            loading={i < 4 ? 'eager' : 'lazy'}
          />
          {img.caption && (
            <figcaption class="gallery-caption">
              <span class="cap-title">{img.caption.title}</span>
              {img.caption.note && <span class="cap-note">{img.caption.note}</span>}
            </figcaption>
          )}
        </button>
      </figure>
    ))
  }
</div>

<!-- Lightbox -->
<div class="lightbox" data-lightbox hidden>
  <button class="lightbox-close" data-lb-close aria-label="Close">&times;</button>
  <figure class="lightbox-figure">
    <img data-lb-img src="" alt="" />
    <figcaption data-lb-cap class="lightbox-cap"></figcaption>
  </figure>
</div>

<style>
  .gallery {
    columns: 3 260px;
    column-gap: 1.1rem;
  }

  .gallery-item {
    margin: 0 0 1.1rem;
    break-inside: avoid;
  }

  .gallery-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .gallery-trigger:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .gallery-trigger :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .gallery-caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-align: left;
    padding: 1.4rem 1rem 0.85rem;
    background: linear-gradient(to top, rgba(43, 39, 36, 0.72), transparent);
    color: var(--white);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .gallery-trigger:hover .gallery-caption,
  .gallery-trigger:focus-visible .gallery-caption {
    opacity: 1;
  }

  .cap-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
  }

  .cap-note {
    font-size: 0.82rem;
    opacity: 0.9;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(30, 27, 24, 0.9);
    backdrop-filter: blur(4px);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-figure {
    margin: 0;
    max-width: 92vw;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .lightbox-figure img {
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.6);
  }

  .lightbox-cap {
    color: var(--cream);
    font-family: var(--font-display);
    font-size: 1.3rem;
    text-align: center;
  }

  .lightbox-cap:empty {
    display: none;
  }

  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 253, 250, 0.12);
    color: var(--cream);
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .lightbox-close:hover {
    background: rgba(255, 253, 250, 0.25);
  }
</style>

<script>
  const lb = document.querySelector('[data-lightbox]');
  if (lb) {
    const lbImg = lb.querySelector('[data-lb-img]');
    const lbCap = lb.querySelector('[data-lb-cap]');

    const open = (btn) => {
      const full = btn.getAttribute('data-full');
      const title = btn.getAttribute('data-title');
      const note = btn.getAttribute('data-note');
      lbImg.src = full;
      lbImg.alt = title || 'Custom pet portrait by ACC Paintings';
      lbCap.textContent = [title, note].filter(Boolean).join(' · ');
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      lb.hidden = true;
      lbImg.src = '';
      document.body.style.overflow = '';
    };

    document.querySelectorAll('[data-gallery] .gallery-trigger').forEach((btn) => {
      btn.addEventListener('click', () => open(btn));
    });

    lb.addEventListener('click', (e) => {
      if (e.target === lb || e.target.hasAttribute('data-lb-close')) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lb.hidden) close();
    });
  }
</script>
