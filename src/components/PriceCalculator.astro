---
// Interactive price finder for the home page.
// Pricing is also encoded in the client script below (kept in sync here for
// the visible cards / server render).
const petOptions = [
  { n: 1, label: 'pet' },
  { n: 2, label: 'pets' },
  { n: 3, label: 'pets' },
  { n: 4, label: 'pets' },
];
---

<div class="calc card" data-calc>
  <!-- Step 1: number of pets -->
  <div class="calc-step" data-step="pets">
    <div class="calc-q">
      <span class="calc-qtext">How many pets do you want painted?</span>
      <span class="calc-answer" data-answer="pets" hidden></span>
      <button class="calc-change" data-change="pets" type="button" hidden>
        Change
      </button>
    </div>
    <div class="calc-options calc-options-pets" data-options="pets">
      {
        petOptions.map((o) => (
          <button
            class="calc-opt calc-opt-pet"
            type="button"
            data-pets={o.n}
            aria-pressed="false"
          >
            <span class="opt-n">{o.n}</span>
            <span class="opt-l">{o.label}</span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Step 2: delivery -->
  <div class="calc-step" data-step="delivery" hidden>
    <div class="calc-q">
      <span class="calc-qtext">Shipped, or local pickup?</span>
      <span class="calc-answer" data-answer="delivery" hidden></span>
      <button class="calc-change" data-change="delivery" type="button" hidden>
        Change
      </button>
    </div>
    <div class="calc-options calc-options-delivery" data-options="delivery">
      <button
        class="calc-opt calc-opt-wide"
        type="button"
        data-delivery="shipped"
        aria-pressed="false"
      >
        <span class="opt-l">Shipped</span>
        <span class="opt-sub">Includes shipping &amp; packaging</span>
      </button>
      <button
        class="calc-opt calc-opt-wide"
        type="button"
        data-delivery="pickup"
        aria-pressed="false"
      >
        <span class="opt-l">Local pickup</span>
        <span class="opt-sub">Capitol Hill, Seattle</span>
      </button>
    </div>
  </div>

  <!-- Result -->
  <div class="calc-result" data-result hidden>
    <div class="calc-result-inner">
      <span class="calc-result-label">Your price</span>
      <span class="calc-price" data-price></span>
      <span class="calc-summary" data-summary></span>
    </div>
    <a href="/commission" class="btn btn-primary">Start a commission</a>
  </div>
</div>

<style>
  .calc {
    padding: clamp(1.6rem, 4vw, 2.6rem);
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .calc-step[hidden],
  .calc-result[hidden] {
    display: none;
  }

  .calc-step.reveal,
  .calc-result.reveal {
    animation: calcIn 0.35s ease;
  }

  @keyframes calcIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Question row */
  .calc-q {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    margin-bottom: 1rem;
  }

  .calc-qtext {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    color: var(--ink);
    transition: color 0.25s ease;
  }

  .calc-step.answered .calc-qtext {
    color: var(--ink-soft);
    opacity: 0.7;
  }

  .calc-step.answered .calc-options {
    display: none;
  }

  .calc-answer {
    margin-left: auto;
    background: var(--accent-soft);
    color: var(--accent-deep);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
  }

  .calc-change {
    background: none;
    border: none;
    color: var(--ink-soft);
    font-family: var(--font-body);
    font-size: 0.85rem;
    text-decoration: underline;
    cursor: pointer;
    padding: 0.2rem;
  }
  .calc-change:hover {
    color: var(--accent-deep);
  }

  /* Options */
  .calc-options-pets {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.9rem;
  }

  .calc-options-delivery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.9rem;
  }

  .calc-opt {
    border: 1.5px solid var(--line);
    background: var(--white);
    border-radius: 12px;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease,
      background 0.15s ease, box-shadow 0.15s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .calc-opt:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }

  .calc-opt[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .calc-opt-pet {
    padding: 1.3rem 0.5rem;
    gap: 0.15rem;
  }

  .opt-n {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent-deep);
    line-height: 1;
  }

  .opt-l {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .calc-opt-wide {
    padding: 1.1rem 1.2rem;
    align-items: flex-start;
    text-align: left;
    gap: 0.25rem;
  }

  .calc-opt-wide .opt-l {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--ink);
  }

  .opt-sub {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  /* Result */
  .calc-result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1.4rem 1.6rem;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--accent-soft), var(--white));
    border: 1px solid var(--line);
  }

  .calc-result-inner {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .calc-result-label {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent-deep);
  }

  .calc-price {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 3.2rem);
    font-weight: 700;
    color: var(--accent-deep);
    line-height: 1.05;
  }

  .calc-summary {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  @media (max-width: 480px) {
    .calc-options-pets {
      grid-template-columns: repeat(2, 1fr);
    }
    .calc-options-delivery {
      grid-template-columns: 1fr;
    }
    .calc-answer {
      margin-left: 0;
    }
  }
</style>

<script>
  const PRICES = {
    1: { shipped: 75, pickup: 60, canvas: '8×8 or 8×10 canvas' },
    2: { shipped: 125, pickup: 110, canvas: '8×10 canvas' },
    3: { shipped: 175, pickup: 160, canvas: '10×20 canvas' },
    4: { shipped: 225, pickup: 210, canvas: '10×20 canvas' },
  };
  const DELIVERY_LABEL = { shipped: 'Shipped', pickup: 'Local pickup' };

  document.querySelectorAll('[data-calc]').forEach((root) => {
    const state = { pets: null, delivery: null };

    const stepEl = (name) => root.querySelector(`[data-step="${name}"]`);
    const answerEl = (name) => root.querySelector(`[data-answer="${name}"]`);
    const changeEl = (name) => root.querySelector(`[data-change="${name}"]`);
    const resultEl = root.querySelector('[data-result]');
    const priceEl = root.querySelector('[data-price]');
    const summaryEl = root.querySelector('[data-summary]');

    const reveal = (el) => {
      if (!el.hidden) return;
      el.hidden = false;
      el.classList.remove('reveal');
      void el.offsetWidth; // restart animation
      el.classList.add('reveal');
    };

    // Mark a step as answered: grey the question, show the chip + Change.
    const answerStep = (name, text) => {
      const step = stepEl(name);
      step.classList.add('answered');
      const chip = answerEl(name);
      chip.textContent = text;
      chip.hidden = false;
      changeEl(name).hidden = false;
    };

    // Re-open a step for editing.
    const editStep = (name) => {
      const step = stepEl(name);
      step.classList.remove('answered');
      answerEl(name).hidden = true;
      changeEl(name).hidden = true;
    };

    const updateResult = () => {
      if (state.pets == null || state.delivery == null) return;
      const info = PRICES[state.pets];
      const amount = info[state.delivery];
      priceEl.textContent = `$${amount}`;
      const petWord = state.pets === 1 ? 'pet' : 'pets';
      summaryEl.textContent = `${state.pets} ${petWord} · ${DELIVERY_LABEL[state.delivery]} · ${info.canvas}`;
      reveal(resultEl);
    };

    // Pet count options
    root.querySelectorAll('[data-pets]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const n = Number(btn.getAttribute('data-pets'));
        state.pets = n;
        root
          .querySelectorAll('[data-pets]')
          .forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
        answerStep('pets', `${n} ${n === 1 ? 'pet' : 'pets'}`);
        reveal(stepEl('delivery'));
        updateResult();
      });
    });

    // Delivery options
    root.querySelectorAll('[data-delivery]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const d = btn.getAttribute('data-delivery');
        state.delivery = d;
        root
          .querySelectorAll('[data-delivery]')
          .forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
        answerStep('delivery', DELIVERY_LABEL[d]);
        updateResult();
      });
    });

    // Change buttons
    root.querySelectorAll('[data-change]').forEach((btn) => {
      btn.addEventListener('click', () => editStep(btn.getAttribute('data-change')));
    });
  });
</script>
