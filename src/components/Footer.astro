  email:
    '<path d="M22 4H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h20a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm-.4 2L12 12.62 2.4 6h19.2ZM2 18V7.24l9.42 6.49a1 1 0 0 0 1.16 0L22 7.24V18H2Z"/>',
};

const links = [
  { href: 'https://www.instagram.com/accpaintings', label: 'Instagram', icon: 'instagram' },
  { href: 'https://www.facebook.com/ACCPaintings', label: 'Facebook', icon: 'facebook' },
  { href: 'https://accpaintings.etsy.com', label: 'Etsy shop', icon: 'etsy' },
  { href: 'mailto:accpaintings@gmail.com', label: 'Email', icon: 'email' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span class="footer-heading">Find me on socials</span>
    <nav class="footer-links" aria-label="Social and contact links">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="social-link"
            aria-label={l.label}
            title={l.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              viewBox="0 0 24 24"
              width="22"
              height="22"
              fill="currentColor"
              aria-hidden="true"
              set:html={icons[l.icon]}
            />
          </a>
        ))
      }
    </nav>
  </div>

  <div class="container footer-bottom">
    <span>© {year} ACC Paintings</span>
    <a href="mailto:accpaintings@gmail.com">accpaintings@gmail.com</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--cream-deep);
    border-top: 1px solid var(--line);
    margin-top: 2rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    padding-block: 3rem 1.5rem;
  }

  .footer-heading {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-style: italic;
    color: var(--ink);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
  }

  .social-link {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    color: var(--ink-soft);
    background: var(--white);
    border: 1px solid var(--line);
    transition: transform 0.15s ease, color 0.15s ease,
      background 0.15s ease, border-color 0.15s ease;
  }

  .social-link:hover {
    color: var(--white);
    background: var(--accent);
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding-block: 1.2rem 2rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
</style>
