---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Custom Pet Portraits</p>
        <h1>A little painting that captures your pet's whole personality.</h1>
        <p class="lead">
          Hand-painted portraits by Aidan that blend cartoon charm with your
          pet's real likeness — meaningful, sentimental keepsakes made to last.
        </p>
        <div class="hero-actions">
          <a href="/commission" class="btn btn-primary">Commission a portrait</a>
          <a href="/gallery" class="btn btn-ghost">See the gallery</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="blob blob-1"></span>
        <span class="blob blob-2"></span>
        <span class="paw">🐾</span>
      </div>
    </div>
  </section>

  <!-- Intro / about -->
  <section class="section">
    <div class="container about-grid">
      <div>
        <p class="eyebrow">The idea</p>
        <h2>Your pet, with a little extra character.</h2>
      </div>
      <div>
        <p>
          Every painting brings together a pet's individuality with a bit of
          cartoon charm — drawn from a background in anime and cartoon art. The
          goal is simple: capture the personality that makes your companion
          <em>them</em>, in a piece you'll want on the wall for years.
        </p>
        <p>
          Portraits are painted from your photos, previewed before they ship,
          and packed with care. Local to Capitol Hill, Seattle? There's a
          discounted pickup option too.
        </p>
      </div>
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Recent work</p>
          <h2>A few favorites</h2>
        </div>
        <a href="/gallery" class="btn btn-ghost">View full gallery</a>
      </div>
      <Gallery limit={6} />
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Simple pricing</p>
          <h2>Priced by canvas size</h2>
        </div>
        <a href="/info" class="btn btn-ghost">Full details & FAQ</a>
      </div>
      <div class="price-grid">
        <div class="card price-card">
          <span class="price-size">8 × 8</span>
          <span class="price-amt">$75</span>
          <span class="price-desc">One pet</span>
        </div>
        <div class="card price-card">
          <span class="price-size">8 × 10</span>
          <span class="price-amt">$75–125</span>
          <span class="price-desc">One or two pets</span>
        </div>
        <div class="card price-card">
          <span class="price-size">10 × 20</span>
          <span class="price-amt">$175–225</span>
          <span class="price-desc">Three or four pets</span>
        </div>
      </div>
      <p class="price-note">
        All prices include shipping & packaging. Capitol Hill, Seattle pickups
        get a local discount.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta card">
        <h2>Ready to commission a portrait?</h2>
        <p>
          Turnaround is currently about 1–2 weeks. Fill out the commission form
          and Aidan will be in touch.
        </p>
        <a href="/commission" class="btn btn-primary">Start a commission</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--accent-soft) 0%, var(--cream) 100%);
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero-copy h1 {
    margin-top: 0.2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .hero-art {
    position: relative;
    min-height: 320px;
    display: grid;
    place-items: center;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
  }

  .blob-1 {
    width: 260px;
    height: 260px;
    background: radial-gradient(circle at 30% 30%, #f4a261, var(--accent));
    opacity: 0.85;
    top: 10%;
    left: 15%;
  }

  .blob-2 {
    width: 180px;
    height: 180px;
    background: radial-gradient(circle at 40% 40%, #a8dadc, #457b9d);
    opacity: 0.8;
    bottom: 8%;
    right: 12%;
  }

  .paw {
    position: relative;
    font-size: 5rem;
    z-index: 1;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.18));
  }

  .about-grid,
  .section-head {
    display: grid;
  }

  .about-grid {
    grid-template-columns: 0.8fr 1.2fr;
    gap: 2.5rem;
    align-items: start;
  }

  .section-alt {
    background: var(--cream-deep);
    border-block: 1px solid var(--line);
  }

  .section-head {
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .section-head h2 {
    margin-bottom: 0;
  }

  .price-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
  }

  .price-card {
    padding: 1.8rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-align: center;
  }

  .price-size {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .price-amt {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--accent-deep);
  }

  .price-desc {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .price-note {
    margin-top: 1.2rem;
    text-align: center;
    font-size: 0.92rem;
  }

  .cta {
    padding: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
    background: linear-gradient(135deg, var(--accent-soft), var(--white));
  }

  .cta h2 {
    margin-bottom: 0.5rem;
  }

  .cta p {
    max-width: 46ch;
    margin-inline: auto;
    margin-bottom: 1.6rem;
  }

  @media (max-width: 820px) {
    .hero-inner,
    .about-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      min-height: 220px;
      order: -1;
    }
    .price-grid {
      grid-template-columns: 1fr;
    }
    .section-head {
      grid-template-columns: 1fr;
    }
  }
</style>
