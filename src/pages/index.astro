---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Carousel from '../components/Carousel.astro';
import PriceCalculator from '../components/PriceCalculator.astro';
import juni from '../gallery/juni.png';
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Custom Pet Portraits</p>
        <h1>Hi, I'm Aidan.</h1>
        <p class="lead">
          I recently started painting custom pet portraits. My background in
          anime and cartoon art influences my style, resulting in portraits
          that combine a pet's individuality with cartoon charm.
        </p>
        <p class="lead">
          I started ACC Paintings to create meaningful, sentimental pieces that
          capture the personality and spirit of the pets people love most.
        </p>
        <div class="hero-actions">
          <a href="/commission" class="btn btn-primary">Commission a portrait</a>
          <a href="/gallery" class="btn btn-ghost">See the gallery</a>
        </div>
      </div>
      <div class="hero-art">
        <span class="hero-blob" aria-hidden="true"></span>
        <Image
          class="hero-img"
          src={juni}
          alt="Custom pet portrait of Juni by ACC Paintings"
          widths={[400, 700]}
          sizes="(max-width: 820px) 70vw, 460px"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Gallery preview -->
  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Gallery</p>
        </div>
      </div>
      <Carousel />
      <div class="carousel-cta">
        <a href="/gallery" class="btn btn-ghost">View full gallery</a>
      </div>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Pricing</p>
        </div>
        <a href="/info" class="btn btn-ghost">Full details & FAQ</a>
      </div>
      <div class="price-calc-wrap">
        <PriceCalculator />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta card">
        <h2>Ready to commission a portrait?</h2>
        <p>
          Turnaround is currently about 1–2 weeks. Fill out the commission form
          and I will be in touch.
        </p>
        <a href="/commission" class="btn btn-primary">Start a commission</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--accent-soft) 0%, var(--cream) 100%);
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero-copy h1 {
    margin-top: 0.2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .hero-art {
    position: relative;
    display: grid;
    place-items: center;
  }

  .hero-blob {
    position: absolute;
    width: 78%;
    aspect-ratio: 1;
    border-radius: 46% 54% 58% 42% / 50% 44% 56% 50%;
    background: radial-gradient(circle at 35% 30%, #f4a261, var(--accent));
    opacity: 0.5;
    filter: blur(6px);
    transform: rotate(-8deg);
  }

  .hero-art :global(.hero-img) {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 440px;
    height: auto;
    border-radius: 18px;
    box-shadow: var(--shadow);
  }

  .section-head {
    display: grid;
  }

  .section-alt {
    background: var(--cream-deep);
    border-block: 1px solid var(--line);
  }

  .section-head {
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .section-head h2 {
    margin-bottom: 0;
  }

  .price-calc-wrap {
    max-width: 720px;
    margin-inline: auto;
  }

  .carousel-cta {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .cta {
    padding: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
    background: linear-gradient(135deg, var(--accent-soft), var(--white));
  }

  .cta h2 {
    margin-bottom: 0.5rem;
  }

  .cta p {
    max-width: 46ch;
    margin-inline: auto;
    margin-bottom: 1.6rem;
  }

  @media (max-width: 820px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-art {
      min-height: 220px;
      order: -1;
    }
    .section-head {
      grid-template-columns: 1fr;
    }
  }
</style>
